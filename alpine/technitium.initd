#!/sbin/openrc-run
# shellcheck shell=sh
# technitium - Technitium DNS Server, bound to the address dns-ip claimed.
#
# Sourced by tests/test_technitium.sh, so everything below must be a variable
# assignment or a function definition. No top-level side effects.

name="technitium"
description="Technitium DNS Server"

TECHNITIUM_DIR="${TECHNITIUM_DIR:-/opt/technitium}"
TECHNITIUM_API="${TECHNITIUM_API:-http://127.0.0.1:5380}"
DNS_IP_RUNFILE="${DNS_IP_RUNFILE:-/run/dns-ip}"
TECHNITIUM_CREDS="${TECHNITIUM_CREDS:-/etc/dns-appliance/admin-password}"

supervisor="supervise-daemon"
command="/usr/bin/dotnet"
command_args="${TECHNITIUM_DIR}/DnsServerApp.dll"
directory="$TECHNITIUM_DIR"
pidfile="/run/technitium.pid"
output_log="/var/log/technitium.log"
error_log="/var/log/technitium.log"
respawn_delay=5
respawn_max=0

depend() {
    # The interlock: if dns-ip fails, OpenRC will not start this service, so
    # the appliance never serves DNS from an address it did not deliberately
    # claim.
    need dns-ip
    after firewall
}

# Validate that $1 is a dotted-quad IPv4 address: four dot-separated numeric
# components, each 0-255, digits only. Rejects whitespace-only content,
# leading/trailing whitespace, and embedded newlines (a non-digit anywhere
# in a component fails the digit test below), since a run file corrupted or
# hand-edited must not flow straight into a curl URL or a DNS bind address.
# Mirrors the validation approach in alpine/dns-ip.initd's octet_base(), so
# the two independent scripts stay consistent for the next reader.
valid_ipv4() {
    case "$1" in
        *.*.*.*.*) return 1 ;;
        *.*.*.*) ;;
        *) return 1 ;;
    esac

    _rest="$1"
    _o1="${_rest%%.*}"
    _rest="${_rest#*.}"
    _o2="${_rest%%.*}"
    _rest="${_rest#*.}"
    _o3="${_rest%%.*}"
    _o4="${_rest#*.}"

    set -- "$_o1" "$_o2" "$_o3" "$_o4"
    for _octet in "$@"; do
        case "$_octet" in
            ''|*[!0-9]*) return 1 ;;
        esac
        if [ "$_octet" -gt 255 ]; then
            return 1
        fi
    done

    return 0
}

# Echo the DNS listen endpoints for a claimed address.
technitium_endpoints() {
    # Validated even though claimed_ip() below already only ever emits a
    # vetted address - technitium_endpoints() is a standalone, independently
    # callable function, and must not build a bind-address string from
    # anything that isn't a genuine dotted-quad, from any caller.
    valid_ipv4 "${1:-}" || return 1
    printf '%s:53,127.0.0.1:53\n' "$1"
}

# Echo the address dns-ip claimed, or fail.
claimed_ip() {
    [ -s "$DNS_IP_RUNFILE" ] || return 1
    _ip=$(cat "$DNS_IP_RUNFILE")
    valid_ipv4 "$_ip" || return 1
    printf '%s\n' "$_ip"
}

# Extract a top-level "key":"value" string field from a small JSON response
# file. Not a general JSON parser - only matches the flat shape the
# Technitium API actually emits. sed/grep only; jq is not available on a
# minimal Alpine image.
json_field() {
    sed -n 's/.*"'"$2"'":"\([^"]*\)".*/\1/p' "$1" 2>/dev/null
}

# Judge an API response by its body, not by curl's exit code: Technitium
# returns HTTP 200 with {"status":"error","errorMessage":"..."} for
# application-level failures (e.g. a stale token), which "curl -fsS" treats
# as success since the transport itself succeeded.
api_ok() {
    [ -f "$1" ] || return 1
    [ "$(json_field "$1" status)" = "ok" ]
}

start_pre() {
    if ! claimed_ip >/dev/null; then
        eerror "$DNS_IP_RUNFILE is missing or empty - dns-ip did not claim an address"
        eerror "Refusing to start the DNS server. Run: rc-service dns-ip start"
        return 1
    fi
    checkpath --directory --mode 0755 "$TECHNITIUM_DIR/config"
    checkpath --file --mode 0644 "$output_log"
}

start_post() {
    # Re-apply the bind address whenever it changes, so moving the stick to a
    # different subnet re-binds without manual intervention. Best effort: the
    # server may still be starting, and a failure here must not take the
    # service down, so it is logged rather than fatal.
    _ip=$(claimed_ip) || return 0
    _endpoints=$(technitium_endpoints "$_ip") || return 0

    [ -s "$TECHNITIUM_CREDS" ] || return 0
    _pass=$(cat "$TECHNITIUM_CREDS")

    _wait=0
    while [ "$_wait" -lt 60 ]; do
        curl -fsS -G "$TECHNITIUM_API/api/user/login" \
            --data-urlencode "user=admin" \
            --data-urlencode "pass=${_pass}" \
            >/run/technitium-login.json 2>/dev/null
        api_ok /run/technitium-login.json && break
        _wait=$((_wait + 2))
        sleep 2
    done

    if ! api_ok /run/technitium-login.json; then
        _err=$(json_field /run/technitium-login.json errorMessage)
        rm -f /run/technitium-login.json
        ewarn "Could not log in to the Technitium API to set the bind address: ${_err:-no response from server}"
        ewarn "The server is running; set it manually in the web console."
        return 0
    fi

    _token=$(json_field /run/technitium-login.json token)
    rm -f /run/technitium-login.json
    if [ -z "$_token" ]; then
        ewarn "Could not log in to the Technitium API to set the bind address."
        ewarn "The server is running; set it manually in the web console."
        return 0
    fi

    curl -fsS -X POST "$TECHNITIUM_API/api/settings/set" \
        --data-urlencode "token=${_token}" \
        --data-urlencode "dnsServerLocalEndPoints=${_endpoints}" \
        >/run/technitium-settings.json 2>/dev/null

    if api_ok /run/technitium-settings.json; then
        einfo "Technitium bound to ${_endpoints}"
    else
        _err=$(json_field /run/technitium-settings.json errorMessage)
        ewarn "Failed to set dnsServerLocalEndPoints to ${_endpoints}: ${_err:-no response from server}"
    fi
    rm -f /run/technitium-settings.json
}
